# Copy this file to ~/.codex-proxy-launcher.env (user-level, survives updates)
# or codex-proxy-launcher.env (working directory).
# Edit if your proxy is not on the default V2Ray HTTP port.
#
# codex-proxy reads config from (in order):
#   1. $CODEX_PROXY_CONFIG          explicit path
#   2. ./codex-proxy-launcher.env   working directory
#   3. ~/.codex-proxy-launcher.env  user-level (recommended)

CODEX_PROXY_HOST=127.0.0.1
CODEX_PROXY_PORT=7898

# --- Advanced overrides ---
# Full URL (takes precedence over HOST+PORT):
# CODEX_PROXY_URL=http://127.0.0.1:7898
# CODEX_PROXY_URL=socks5://127.0.0.1:1080

# Custom Codex path (if not in /Applications):
# CODEX_APP_PATH=/Applications/Codex.app/Contents/MacOS/Codex
